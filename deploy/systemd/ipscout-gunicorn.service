[Unit]
Description=IP Scout - Gunicorn application server
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=ipscout
Group=ipscout
WorkingDirectory=/opt/ipscout
EnvironmentFile=/opt/ipscout/.env
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/opt/ipscout/.venv/bin/gunicorn config.wsgi:application \
    --bind 127.0.0.1:8000 \
    --workers 4 \
    --timeout 30 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
