# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Either set DATABASE_URL, or the individual POSTGRES_* vars below.
DATABASE_URL=postgres://ipscout:ipscout@postgres:5432/ipscout
POSTGRES_DB=ipscout
POSTGRES_USER=ipscout
POSTGRES_PASSWORD=ipscout
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
CELERY_WORKER_PREFETCH_MULTIPLIER=1
WHOIS_QUEUE_CONCURRENCY=4

# --- WHOIS ---
WHOIS_BINARY=/usr/bin/whois
WHOIS_TIMEOUT=10
WHOIS_CACHE_DAYS=7

# --- Retention (days) ---
REQUEST_RETENTION_DAYS=30
WHOIS_RETENTION_DAYS=180
IP_RETENTION_DAYS=365
INCIDENT_RETENTION_DAYS=365

# --- Iran CIDR ---
# "static": CountryNetwork rows entered via /admin or Iran > CIDRs are
#   the source of truth; monthly validation is a self-consistency pass.
# "ripencc": fetches RIPE NCC's own delegated-extended stats file (real,
#   freely published, no API key) and extracts every IPv4/IPv6 block
#   currently allocated/assigned to Iran - see apps/iran/providers.py.
IRAN_CIDR_SOURCE=static
IRAN_RIPE_STATS_URL=https://ftp.ripe.net/pub/stats/ripencc/delegated-ripencc-extended-latest
IRAN_RIPE_STATS_TIMEOUT=30

# --- GeoIP ---
# "null" (default) never populates geo fields - no dataset is bundled.
# Set to "maxmind" + a .mmdb path to enable lookups: MaxMind's own
# GeoLite2-City needs a free account; DB-IP's City Lite
# (download.db-ip.com/free/, CC BY 4.0, no signup) is in the same
# format and works against this provider unmodified.
GEOIP_PROVIDER=null
GEOIP_DATABASE_PATH=

# --- SSH ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SSH_CREDENTIAL_ENCRYPTION_KEY=
SSH_CONNECT_TIMEOUT=10

# --- JWT ---
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Misc ---
TIME_ZONE=UTC
CORS_ALLOWED_ORIGINS=
LOG_LEVEL=INFO
LOG_FORMAT=console
SESSION_COOKIE_AGE=28800

# --- Production only ---
SECURE_SSL_REDIRECT=true
SENTRY_DSN=
